{
  "id": "privacy-description",
  "title": "The description of an event never reaches the target at the default detail level",
  "covers": "data that must not reach the target",
  "expectedText": "A block exists, and none of its fields holds the description of the event. This scenario checks data only, not times.",
  "calendars": {
    "source": {
      "timeZone": "UTC"
    },
    "target": {
      "timeZone": "UTC"
    }
  },
  "steps": [
    {
      "do": "write",
      "change": "create",
      "key": "meeting",
      "event": {
        "start": "week+1d@10:00Z",
        "end": "week+1d@11:00Z",
        "title": "Meeting",
        "location": "Room",
        "description": "SUITE-CONTENT-DESCRIPTION-7Q2",
        "attendees": ["person@example.invalid"]
      }
    },
    {
      "do": "sync",
      "settleSeconds": 600,
      "expect": {
        "window": ["week@00:00Z", "week+7d@00:00Z"],
        "minEntries": 1,
        "forbidden": ["SUITE-CONTENT-DESCRIPTION-7Q2"]
      }
    }
  ]
}
