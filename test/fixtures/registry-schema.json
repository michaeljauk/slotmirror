  "others": [
    {
      "type": "trigger",
      "name": "cleanup_tombstones_rule_gone",
      "tableName": "rules",
      "sql": "CREATE TRIGGER cleanup_tombstones_rule_gone AFTER DELETE ON rules WHEN OLD.enabled = 1 BEGIN DELETE FROM cleanup_tombstones WHERE rule_id = OLD.id AND state <> 'open' AND EXISTS(SELECT 1 FROM users u WHERE u.id = OLD.user_id); END"
    },
    {
      "type": "trigger",
      "name": "cleanup_tombstones_rule_off",
      "tableName": "rules",
      "sql": "CREATE TRIGGER cleanup_tombstones_rule_off AFTER UPDATE OF enabled ON rules WHEN OLD.enabled = 1 AND NEW.enabled = 0 BEGIN DELETE FROM cleanup_tombstones WHERE rule_id = NEW.id AND state <> 'open' AND EXISTS(SELECT 1 FROM users u WHERE u.id = NEW.user_id); END"
    },
    {
      "type": "trigger",
      "name": "rule_holds_end",
      "tableName": "rules",
      "sql": "CREATE TRIGGER rule_holds_end AFTER UPDATE OF enabled ON rules WHEN NEW.enabled = 1 BEGIN DELETE FROM rule_holds WHERE rule_id = NEW.id; END"
    }
  ]
}
