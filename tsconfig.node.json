{
  // Typecheck of the core for the Node runtime. Node types replace the workerd types, and
  // src/runtime/node/cloudflare-globals.ts declares the Cloudflare names as the runtime subset.
  // If the core uses a Cloudflare API outside src/runtime/types.ts, this check fails.
  // src/index.tsx and src/runtime/workers are the Cloudflare entry and adapter and stay with
  // tsconfig.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/index.tsx", "src/runtime/workers"]
}
