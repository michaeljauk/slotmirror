---
// An isometric illustration from boxes. A hatched top gets one stripe pattern per colour, so a copy
// looks like the hatched half of the logo.
import { type Box, isoBoxes, viewBox } from "../iso";

interface Props {
  boxes: Box[];
  id: string;
  scale?: number;
  class?: string;
}
const { boxes, id, scale = 20, class: className } = Astro.props;
const hatches = [...new Set(boxes.filter((box) => box.hatch).map((box) => box.hatch!))];
const patternId = (hatch: string) => `${id}-hatch-${hatches.indexOf(hatch)}`;
const faces = isoBoxes(
  boxes.map((box) => (box.hatch ? { ...box, hatch: patternId(box.hatch) } : box)),
  scale,
);
---

<svg
  class={className}
  viewBox={viewBox(boxes, scale)}
  aria-hidden="true"
>
  <defs>
    {
      hatches.map((hatch) => (
        <pattern
          id={patternId(hatch)}
          width="7"
          height="7"
          patternUnits="userSpaceOnUse"
          patternTransform="rotate(45)"
        >
          <rect width="3.2" height="7" style={`fill: ${hatch}`} />
        </pattern>
      ))
    }
  </defs>
  {
    faces.map((face) => (
      <polygon
        points={face.points}
        style={`fill: ${face.fill}`}
        stroke-linejoin="round"
      />
    ))
  }
</svg>
