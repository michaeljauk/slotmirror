---
// A field of calendar slots for gradient backgrounds: some solid, some hatched like a copy, with a
// fixed pseudo-random brightness, so every build draws the same field.
interface Props {
  id: string;
  cols?: number;
  rows?: number;
  class?: string;
}
const { id, cols = 18, rows = 12, class: className } = Astro.props;
const W = 46;
const H = 26;
const GAP = 8;
const cells: { x: number; y: number; opacity: number; hatched: boolean }[] = [];
for (let row = 0; row < rows; row++) {
  for (let col = 0; col < cols; col++) {
    const n = Math.sin(col * 12.9898 + row * 78.233) * 43758.5453;
    const r = n - Math.floor(n);
    if (r < 0.55) continue;
    cells.push({
      x: col * (W + GAP) + (row % 2) * ((W + GAP) / 2),
      y: row * (H + GAP),
      opacity: 0.03 + (r - 0.55) * 0.22,
      hatched: r > 0.93,
    });
  }
}
---

<svg
  class={className}
  viewBox={`0 0 ${cols * (W + GAP)} ${rows * (H + GAP)}`}
  preserveAspectRatio="xMaxYMid slice"
  aria-hidden="true"
>
  <defs>
    <pattern
      id={`${id}-hatch`}
      width="6"
      height="6"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(45)"
    >
      <rect width="2.6" height="6" fill="#fff"></rect>
    </pattern>
  </defs>
  {
    cells.map((cell) => (
      <rect
        x={cell.x}
        y={cell.y}
        width={W}
        height={H}
        rx="6"
        fill={cell.hatched ? `url(#${id}-hatch)` : "#fff"}
        opacity={cell.hatched ? Math.min(cell.opacity * 2, 0.32) : cell.opacity}
      />
    ))
  }
</svg>
