          </div>
          <div class="cals-wrap">
            <div class="cals">
              <div><div class="cal-name">&nbsp;</div><div class="hours" id="hours"></div></div>
              <div style="--c:var(--work)">
                <div class="cal-name"><i></i><Fragment set:html={microsoft} />Work</div>
                <div class="cal" data-cal="work"></div>
