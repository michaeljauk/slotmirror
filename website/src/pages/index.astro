    <script>
      // The waitlist code loads only if this build renders the form.
      if (document.querySelector("#waitlist-form")) void import("../scripts/waitlist");
    </script>

    <script>
      // A toy version of the sync. One meeting per calendar; each can move, and its copies follow
      // in the other calendars. Colour means "which calendar it came from".
      const START = 8;
      const END = 18;
      const HEIGHT = 420;
      const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const px = (hour: number) => ((hour - START) / (END - START)) * HEIGHT;
      const LEVELS = ["off", "busy", "title", "full"] as const;
      type Level = (typeof LEVELS)[number];
      type Cal = "work" | "client" | "private";
      type Target = "client" | "private";
      type Slot = { start: number; length: number };
      const CALS: Cal[] = ["work", "client", "private"];
      const TARGETS: Target[] = ["client", "private"];
      const SHORT: Record<Level, string> = { off: "Not", busy: "Busy", title: "Title", full: "All" };
      const COLOUR: Record<Cal, string> = {
        work: "var(--work)",
        client: "var(--client)",
        private: "var(--private)",
      };
      const NAME: Record<Cal, string> = { work: "Work", client: "Client", private: "Private" };
      // What each calendar's meeting shows in the others. The matrix edits the Work row.
      const show: Record<Cal, Partial<Record<Cal, Level>>> = {
        work: { client: "busy", private: "full" },
        client: { work: "busy", private: "off" },
        private: { work: "busy", client: "busy" },
      };
      const cals = Object.fromEntries(
        [...document.querySelectorAll<HTMLElement>(".cal")].map((el) => [el.dataset.cal, el]),
      ) as Record<Cal, HTMLElement>;
      const hours = document.getElementById("hours")!;
      for (let h = START; h <= END; h += 2) {
        const label = document.createElement("span");
        label.style.top = `${px(h)}px`;
        label.textContent = `${h}:00`;
        hours.append(label);
      }
      const time = (h: number) => `${Math.floor(h)}:${h % 1 ? "30" : "00"}`;
      const span = (slot: Slot) => `${time(slot.start)}–${time(slot.start + slot.length)}`;
      const slots = new Map<HTMLElement, Slot>();
      // Overlapping events sit side by side, like in a calendar app: lane i of n.
      function lanes(cal: Cal, override?: [HTMLElement, Slot]) {
        const items = [...cals[cal].querySelectorAll<HTMLElement>(".ev:not(.hidden)")]
          .map((el) => ({ el, slot: el === override?.[0] ? override[1] : slots.get(el) }))
          .filter((item): item is { el: HTMLElement; slot: Slot } => item.slot !== undefined)
          .sort((a, b) => a.slot.start - b.slot.start);
        const result = new Map<HTMLElement, { i: number; n: number }>();
        let cluster: HTMLElement[] = [];
        let ends: number[] = [];
        let clusterEnd = -Infinity;
        const close = () => {
          for (const el of cluster) result.get(el)!.n = ends.length;
          cluster = [];
          ends = [];
        };
        for (const { el, slot } of items) {
          if (slot.start >= clusterEnd) close();
          const free = ends.findIndex((end) => end <= slot.start);
          const i = free < 0 ? ends.length : free;
          ends[i] = slot.start + slot.length;
          result.set(el, { i, n: 0 });
          cluster.push(el);
          clusterEnd = Math.max(clusterEnd, slot.start + slot.length);
        }
        close();
        return result;
      }
      function layout(cal: Cal) {
        for (const [el, { i, n }] of lanes(cal)) {
          el.style.left = `calc(4px + (100% - 8px) * ${i / n})`;
          el.style.right = `calc(4px + (100% - 8px) * ${(n - i - 1) / n})`;
          el.style.marginLeft = i ? "2px" : "0";
        }
      }
      function place(el: HTMLElement, slot: Slot) {
        slots.set(el, { ...slot });
        el.style.top = `${px(slot.start)}px`;
        el.style.height = `${px(START + slot.length) - 2}px`;
      }
      const copyHint = (source: Cal) => `<span class="sr">Copy from ${NAME[source]}: </span>`;
      type Meeting = Slot & {
        cal: Cal;
        title: string;
        where?: string;
        el: HTMLElement;
        copies: Partial<Record<Cal, HTMLElement>>;
        timer?: ReturnType<typeof setTimeout>;
        arcs?: SVGGElement;
      };
      function addEvent(cal: Cal, source: Cal, kind: string) {
        const el = document.createElement("div");
        el.className = `ev ${kind}`;
        el.style.setProperty("--c", COLOUR[source]);
        cals[cal].append(el);
        return el;
      }
      const seeds: (Slot & Pick<Meeting, "cal" | "title" | "where">)[] = [
        { cal: "work", title: "Client call", where: "Teams", start: 10, length: 1 },
        { cal: "client", title: "Workshop", start: 13, length: 1 },
        { cal: "private", title: "Dentist", start: 16.5, length: 1 },
      ];
      const meetings: Meeting[] = seeds.map((seed) => {
        const el = addEvent(seed.cal, seed.cal, "real movable");
        el.tabIndex = 0;
        el.setAttribute("role", "button");
        const copies: Meeting["copies"] = {};
        for (const cal of CALS) if (cal !== seed.cal) copies[cal] = addEvent(cal, seed.cal, "copy");
        return { ...seed, el, copies };
      });
      const clientCall = meetings[0]!;
      function drawReal(m: Meeting) {
        place(m.el, m);
        m.el.innerHTML = `${m.title}<small>${span(m)}</small>`;
        m.el.setAttribute("aria-label", `${m.title}, ${span(m)}. Move it with the arrow keys.`);
        layout(m.cal);
      }
      function drawCopy(m: Meeting, cal: Cal) {
        const el = m.copies[cal]!;
        const level = show[m.cal][cal]!;
        el.classList.toggle("hidden", level === "off");
        place(el, m);
        const label = level === "busy" ? "Busy" : m.title;
        const extra = level === "full" && m.where ? ` · ${m.where}` : "";
        el.innerHTML = `${copyHint(m.cal)}${label}<small>${span(m)}${extra}</small>`;
        layout(cal);
      }
      const copyCals = (m: Meeting) => CALS.filter((cal) => cal !== m.cal);
      // Arcs with a travelling dot, from the moved original to the slot where each copy will land,
      // while the sync runs. The copy then slides into place under the dot.
      const arcs = document.getElementById("arcs")!;
      const wrap = document.querySelector(".cals-wrap")!;
      const SVG = "http://www.w3.org/2000/svg";
      // Where an event sits in the wrapper once its column has its final layout.
      function box(cal: Cal, el: HTMLElement, slot: Slot) {
        const outer = wrap.getBoundingClientRect();
        const column = cals[cal].getBoundingClientRect();
        const width = cals[cal].clientWidth - 8;
        const { i, n } = lanes(cal, [el, slot]).get(el)!;
        const left = column.left - outer.left + cals[cal].clientLeft + 4 + (width * i) / n;
        const top = column.top - outer.top + cals[cal].clientTop + px(slot.start);
        return { left, right: left + width / n, middle: top + (px(START + slot.length) - 2) / 2 };
      }
      function drawArcs(m: Meeting) {
        m.arcs?.remove();
        const group = document.createElementNS(SVG, "g");
        arcs.append(group);
        m.arcs = group;
        const colour = getComputedStyle(m.el).backgroundColor;
        const from = box(m.cal, m.el, m);
        for (const cal of copyCals(m)) {
          if (show[m.cal][cal] === "off") continue;
          const to = box(cal, m.copies[cal]!, m);
          const right = to.left > from.left;
          const x1 = right ? from.right - 4 : from.left + 4;
          const x2 = right ? to.left + 8 : to.right - 8;
          const { middle: y } = from;
          // Bow upwards, or downwards near the top of the day, so that the arcs to the near and the
          // far calendar do not lie on one line.
          const bow = Math.min(64, Math.abs(x2 - x1) * 0.35) * (y > 70 ? -1 : 1);
          const third = (x2 - x1) / 3;
          const path = document.createElementNS(SVG, "path");
          path.setAttribute(
            "d",
            `M ${x1} ${y} C ${x1 + third} ${y + bow}, ${x2 - third} ${y + bow}, ${x2} ${y}`,
          );
          path.setAttribute("stroke", colour);
          group.append(path);
          const length = path.getTotalLength();
          path.style.strokeDasharray = `${length}`;
          path.animate([{ strokeDashoffset: length }, { strokeDashoffset: 0 }], {
            duration: 700,
            easing: "ease-out",
            fill: "forwards",
          });
          const dot = document.createElementNS(SVG, "circle");
          dot.setAttribute("r", "3.5");
          dot.setAttribute("fill", colour);
          group.append(dot);
          const steps = 24;
          const frames = Array.from({ length: steps + 1 }, (_, i) => {
            const point = path.getPointAtLength((length * i) / steps);
            return { transform: `translate(${point.x}px, ${point.y}px)` };
          });
          dot.animate(frames, { duration: 700, easing: "ease-out", fill: "forwards" });
        }
      }
      const status = document.getElementById("status")!;
      const statusText = document.getElementById("status-text")!;
      // Each meeting syncs on its own, so moving a second one does not cancel the first.
      function drawStatus() {
        const busy = meetings.some((m) => m.timer !== undefined);
        status.classList.toggle("busy", busy);
        statusText.textContent = busy ? "Syncing…" : "In sync";
      }
      function sync(m: Meeting) {
        if (reduced) {
          for (const cal of copyCals(m)) drawCopy(m, cal);
          return;
        }
        clearTimeout(m.timer);
        m.el.classList.add("waiting");
        drawArcs(m);
        m.timer = setTimeout(() => {
          m.timer = undefined;
          for (const cal of copyCals(m)) {
            drawCopy(m, cal);
            const el = m.copies[cal]!;
            el.classList.remove("arrived");
            void el.offsetWidth;
            el.classList.add("arrived");
          }
          m.el.classList.remove("waiting");
          drawStatus();
          const group = m.arcs;
          setTimeout(() => group?.remove(), 500);
        }, 800);
        drawStatus();
      }
      function moveTo(m: Meeting, start: number) {
        const next = Math.min(END - m.length, Math.max(START, start));
        if (next === m.start) return false;
        m.start = next;
        drawReal(m);
        if (m === clientCall) move.textContent = next === 14 ? "Move to 10:00" : "Move to 14:00";
        return true;
      }
      const move = document.getElementById("move")!;
      move.addEventListener("click", () => {
        if (moveTo(clientCall, clientCall.start === 14 ? 10 : 14)) sync(clientCall);
      });
      // Drag an original in half-hour steps, or move it with the arrow keys.
      for (const m of meetings) {
        let drag: { y: number; start: number } | null = null;
        m.el.addEventListener("pointerdown", (event) => {
          if (event.button !== 0) return;
          drag = { y: event.clientY, start: m.start };
          m.el.classList.add("dragging");
          m.el.setPointerCapture(event.pointerId);
        });
        m.el.addEventListener("pointermove", (event) => {
          if (!drag) return;
          const delta = ((event.clientY - drag.y) / HEIGHT) * (END - START);
          moveTo(m, Math.round((drag.start + delta) * 2) / 2);
        });
        const drop = () => {
          if (!drag) return;
          const moved = drag.start !== m.start;
          drag = null;
          m.el.classList.remove("dragging");
          if (moved) sync(m);
        };
        m.el.addEventListener("pointerup", drop);
        m.el.addEventListener("pointercancel", drop);
        m.el.addEventListener("keydown", (event) => {
          const step = { ArrowUp: -0.5, ArrowDown: 0.5 }[event.key];
          if (!step) return;
          event.preventDefault();
          if (moveTo(m, m.start + step)) sync(m);
        });
      }
      // Mini matrix: what the Work meeting shows in each other calendar.
      const matrix = document.getElementById("matrix")!;
      function drawMatrix() {
        matrix.innerHTML = `<tr><th style="--c:var(--work)"><i></i>Work →</th><th style="--c:var(--client)"><i></i>Client</th><th style="--c:var(--private)"><i></i>Private</th></tr>
          <tr><th></th>${TARGETS.map((cal) => `<td><button type="button" class="lv-${show.work[cal]}" data-cal="${cal}" aria-label="${NAME[cal]}: ${SHORT[show.work[cal]!]}. Change">${SHORT[show.work[cal]!]}</button></td>`).join("")}</tr>`;
      }
      matrix.addEventListener("click", (event) => {
        const cell = (event.target as HTMLElement).closest<HTMLElement>("button[data-cal]");
        if (!cell) return;
        const cal = cell.dataset.cal as Target;
        show.work[cal] = LEVELS[(LEVELS.indexOf(show.work[cal]!) + 1) % LEVELS.length]!;
        drawMatrix();
        drawCopy(clientCall, cal);
        matrix.querySelector<HTMLElement>(`button[data-cal="${cal}"]`)?.focus();
      });
      drawMatrix();
      for (const m of meetings) {
        drawReal(m);
        for (const cal of copyCals(m)) drawCopy(m, cal);
      }
    </script>
  </body>
</html>
