---
import { Image } from "astro:assets";
import editor from "../../../docs/images/editor.png";
import "../styles/home.css";

const repo = "https://github.com/michaeljauk/slotmirror";
const title = "slotmirror: stop getting double-booked across Microsoft and Google calendars";
const description =
  "Self-hosted busy-time sync between Microsoft 365 and Google calendars. By default only Busy leaves a calendar. Runs in your own Cloudflare account, on the free plan.";

// Hero sentence, two variants. No latency has been measured yet, so the live variant names no
// number. After the measurement, replace `null` with the measured values and the conditions, for example { p50: "<value>", p95: "<value>", conditions: "<what was measured>" }.
// That one change turns on the second variant. Never fill in a figure that was not measured.
const latency: { p50: string; p95: string; conditions: string } | null = null;
const heroSub = latency
  ? `By default only "Busy" leaves your calendar. A moved, cancelled or changed meeting updates its copies in a median of ${latency.p50} (p95: ${latency.p95}; ${latency.conditions}). It runs in your own Cloudflare account on the free plan, with no server to run.`
  : `By default only "Busy" leaves your calendar. A moved, cancelled or changed meeting updates its copies. It runs in your own Cloudflare account on the free plan, with no server to run. The default window is the next 90 days.`;

// Links inside the site. The base comes from astro.config.mjs, the only place that sets it.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const page = (path: string) => `${base}/${path}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = new URL(page("social-preview.png"), Astro.site);

// The waitlist form shows only if both build variables are set. Without them nothing renders.
const waitlistUrl = (import.meta.env.PUBLIC_WAITLIST_URL as string | undefined)
  ?.trim()
  .replace(/\/$/, "");
const turnstileKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined)?.trim();
// An address without https:// would make a relative endpoint, so it counts as unset.
const waitlist = Boolean(waitlistUrl?.startsWith("https://") && turnstileKey);

const guides = [
  {
    slug: "sync-outlook-and-google-calendar",
    title: "Sync Outlook and Google Calendar",
    text: "Busy blocks or titles, in both directions.",
  },
  {
    slug: "show-private-calendar-as-busy-at-work",
    title: "Show your private calendar as busy at work",
    text: "Block the time without showing what it is.",
  },
  {
    slug: "sync-multiple-microsoft-365-tenants",
    title: "Sync calendars across Microsoft 365 tenants",
    text: "Two companies, or client tenants.",
  },
  {
    slug: "block-team-or-club-calendar",
    title: "Block time for a team or club schedule",
    text: "A subscribed calendar becomes busy blocks.",
  },
];

// release-please writes CHANGELOG.md at the repository root with the first release.
const changelogs = import.meta.glob<string>("../../../CHANGELOG.md", {
  query: "?raw",
  import: "default",
  eager: true,
});
const changelog = Object.values(changelogs)[0] ?? "";
const latest = /^##\s+\[?(\d+\.\d+\.\d+)\]?(?:\([^)]*\))?\s*\((\d{4}-\d{2}-\d{2})\)/m.exec(
  changelog,
);

const microsoft = `<svg viewBox="0 0 21 21" aria-hidden="true"><rect width="10" height="10" fill="#f25022"/><rect x="11" width="10" height="10" fill="#7fba00"/><rect y="11" width="10" height="10" fill="#00a4ef"/><rect x="11" y="11" width="10" height="10" fill="#ffb900"/></svg>`;
const google = `<svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9 3.6l6.7-6.7C35.6 2.4 30.2 0 24 0 14.6 0 6.6 5.4 2.6 13.3l7.8 6C12.3 13.6 17.7 9.5 24 9.5z"/><path fill="#4285F4" d="M46.1 24.6c0-1.6-.1-3.1-.4-4.6H24v9h12.4c-.5 2.9-2.2 5.3-4.6 6.9l7.4 5.7c4.3-4 6.9-9.9 6.9-17z"/><path fill="#FBBC05" d="M10.4 28.7c-.5-1.4-.8-3-.8-4.7s.3-3.2.8-4.7l-7.8-6C.9 16.6 0 20.2 0 24s.9 7.4 2.6 10.7l7.8-6z"/><path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.4-5.7c-2.1 1.4-4.8 2.3-8.5 2.3-6.3 0-11.7-4.1-13.6-9.8l-7.8 6C6.6 42.6 14.6 48 24 48z"/></svg>`;
const github = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>`;
const cloudflare = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.5 15.9c.16-.55.1-1.06-.17-1.43-.25-.35-.66-.55-1.16-.57l-9.47-.12a.19.19 0 0 1-.15-.08.2.2 0 0 1-.02-.17.26.26 0 0 1 .22-.17l9.56-.12c1.13-.05 2.36-.97 2.79-2.09l.55-1.42a.33.33 0 0 0 .01-.19 6.23 6.23 0 0 0-11.97-.65 2.8 2.8 0 0 0-4.42 2.93A3.98 3.98 0 0 0 0 15.8c0 .2.02.39.04.58a.19.19 0 0 0 .18.16h17.5a.24.24 0 0 0 .22-.17l.13-.47Zm3.03-6.1h-.27a.16.16 0 0 0-.15.12l-.37 1.29c-.16.55-.1 1.06.17 1.43.25.35.66.55 1.16.57l2.02.12a.18.18 0 0 1 .14.08.2.2 0 0 1 .02.17.26.26 0 0 1-.22.17l-2.1.12c-1.14.05-2.37.97-2.8 2.09l-.15.4a.11.11 0 0 0 .1.15h7.22a.19.19 0 0 0 .18-.14 5.17 5.17 0 0 0-4.95-6.57Z"/></svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
