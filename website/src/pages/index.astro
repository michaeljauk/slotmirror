---
import Demo from "../components/Demo.astro";
import DetailPicker from "../components/DetailPicker.astro";
import GroupMock from "../components/mock/GroupMock.astro";
import RulesMock from "../components/mock/RulesMock.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { detail, guides, hero, more } from "../home-content";
import { github, google, microsoft } from "../icons";
import { previewAlt, previewHeight, previewWidth, repo } from "../site";
import {
  blocks,
  hosted,
  neverStored,
  neverStoredNote,
  permissions,
  setup,
  signInScopes,
  stored,
  storedNote,
  where,
} from "../trust-content";
import { waitlist } from "../waitlist-config";
import "../styles/landing.css";

// The search title is short enough for a result page (about 60 characters). Link previews keep
// the hero headline as their title.
const searchTitle = "slotmirror: busy-time sync for Outlook and Google calendars";
const title = "slotmirror: stop getting double-booked across Microsoft and Google calendars";
const description =
  "Sync Outlook and Google calendars as busy blocks. By default only Busy leaves a calendar. Self-hosted in your own Cloudflare account, on the free plan.";

// Hero sentence, two variants. No latency has been measured yet, so the live variant names no
// number. After the measurement, replace `null` with the measured values and the conditions, for
// example { p50: "<value>", p95: "<value>", conditions: "<what was measured>" }. That one change
// adds the second sentence. Never fill in a figure that was not measured.
const latency: { p50: string; p95: string; conditions: string } | null = null;
const heroSub = latency
  ? `${hero.sub} A moved meeting updates its copies in a median of ${latency.p50} (p95: ${latency.p95}; ${latency.conditions}).`
  : hero.sub;

// Links inside the site. The base comes from astro.config.mjs, the only place that sets it.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const page = (path: string) => `${base}/${path}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const preview = new URL(page("social-preview.png"), Astro.site);

// release-please writes CHANGELOG.md at the repository root with the first release.
const changelogs = import.meta.glob<string>("../../../CHANGELOG.md", {
  query: "?raw",
  import: "default",
  eager: true,
});
const changelog = Object.values(changelogs)[0] ?? "";
const latest = /^##\s+\[?(\d+\.\d+\.\d+)\]?(?:\([^)]*\))?\s*\((\d{4}-\d{2}-\d{2})\)/m.exec(
  changelog,
);

// Structured data for search engines. Every value here is also visible on the page or in the
// repository. The version appears only after the first release.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${canonical.href}#website`,
      name: "slotmirror",
      url: canonical.href,
      description,
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${canonical.href}#software`,
      name: "slotmirror",
      description,
      url: canonical.href,
      image: preview.href,
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      sameAs: [repo],
      ...(latest ? { softwareVersion: latest[1] } : {}),
    },
  ],
};
// JSON inside a script tag must not contain "</script>", so every "<" becomes an escape.
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<SiteLayout title={searchTitle} description={description} bodyClass="home">
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="slotmirror" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={preview} />
    <meta property="og:image:width" content={previewWidth} />
    <meta property="og:image:height" content={previewHeight} />
    <meta property="og:image:alt" content={previewAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={preview} />
    <meta name="twitter:image:alt" content={previewAlt} />
    <script type="application/ld+json" is:inline set:html={structuredDataJson} />
  </Fragment>

  <div class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>{hero.title}</h1>
        <p class="sub">{heroSub}</p>
        <div class="buttons">
          <a class="button primary" href={page("docs/quickstart/")} data-track="quickstart_click"
            >Set it up yourself</a
          >
          {
            waitlist && (
              <a class="button" href="#waitlist" data-track="waitlist_jump">
                Join the hosted waitlist
              </a>
            )
          }
        </div>
        <p class="fine">
          {hero.free}{" "}
          <a href={repo}><Fragment set:html={github} />Source on GitHub</a>
        </p>
      </div>
      <div class="frame"><Demo /></div>
    </div>
  </div>

  <section class="split">
    <div class="split-text">
      <h2>{detail.title}</h2>
      <p>{detail.lead}</p>
      <p class="muted">Try it: pick a level and see what the copy shows in the other calendar.</p>
    </div>
    <div class="frame"><DetailPicker /></div>
  </section>

  <section>
    <figure
      class="mock-figure"
      role="img"
      aria-label="A mockup of the rules page. For events from Work, a cursor picks a level for Personal: Not, As busy, With title, Everything. The preview of the copy and the overview change with it."
    >
      <RulesMock />
    </figure>
  </section>

  <section class="split split-even">
    <div class="split-text">
      <h2>{more.title}</h2>
      <p>{more.text}</p>
    </div>
    <figure
      class="mock-figure"
      role="img"
      aria-label="A mockup of a block group: Work, Client and Private. Each meeting appears in its own calendar, then as a busy copy in the other two. A subscribed team calendar is only read."
    >
      <GroupMock />
    </figure>
  </section>

  <section id="trust">
    <h2>Before you connect a calendar</h2>
    <p class="lead">{where}</p>
    <div class="trust">
      <div class="trust-col">
        <h3>What it asks for</h3>
        <ul class="scopes">
          {
            permissions.map((item) => (
              <li>
                <span class="provider">
                  <Fragment set:html={item.provider === "Google" ? google : microsoft} />
                  <code>{item.scope}</code>
                </span>
                <span class="muted">{item.why}</span>
              </li>
            ))
          }
        </ul>
        <p class="small">{signInScopes}</p>
        <p class="small">{blocks}</p>
      </div>
      <div class="trust-col">
        <h3>What the database holds</h3>
        <ul class="plain-list">{stored.map((item) => <li>{item}</li>)}</ul>
        <p class="small">
          {storedNote} <a href={page("docs/privacy/")}>Privacy and data location</a>
        </p>
      </div>
      <div class="trust-col">
        <h3>What it never stores</h3>
        <ul class="struck">{neverStored.map((item) => <li>{item}</li>)}</ul>
        <p class="small">{neverStoredNote}</p>
        <p class="small">
          <a href={page("docs/privacy/")}>Privacy and data location</a>{" "}
          <span aria-hidden="true">·</span>{" "}
          <a href={repo}>Read the code</a>
        </p>
      </div>
    </div>
  </section>

  <section id="paths">
    <h2>Two ways to run it</h2>
    <div class="paths">
      <div class="path">
        <p class="tag tag-ok">Available now</p>
        <h3>Run it yourself</h3>
        <p>What you need:</p>
        <ul class="plain-list">{setup.needs.map((item) => <li>{item}</li>)}</ul>
        <p class="muted">{setup.effort}</p>
        <div class="buttons">
          <a class="button primary" href={page("docs/quickstart/")} data-track="quickstart_click"
            >Open the quickstart</a
          >
          <a class="button" href={page("guides/self-hosted-calendar-sync/")}
            >What self-hosting means</a
          >
        </div>
      </div>
      <div class="path" id="waitlist">
        <p class="tag">{hosted.status}</p>
        <h3>{hosted.title}</h3>
        <p>{waitlist ? `${hosted.text} ${hosted.join}` : hosted.text}</p>
        {waitlist ? <WaitlistForm /> : <p class="muted">The waitlist opens soon.</p>}
      </div>
    </div>
    <p class="small">
      slotmirror is below 1.0. Settings and the database can still change between releases.
    </p>
  </section>

  <section id="guides">
    <h2>Guides for common setups</h2>
    <ul class="guide-list">
      {
        guides.map((guide) => (
          <li>
            <a href={page(`guides/${guide.slug}/`)}>
              <span class="g-title">{guide.title}</span>
              <span class="g-text">{guide.text}</span>
              <span class="g-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    latest && (
      <section id="changelog">
        <h2>Changelog</h2>
        <p class="changes">
          <span class="version">{latest[1]}</span>
          <time datetime={latest[2]}>{latest[2]}</time>
          <a href={page("changelog/")}>All releases</a>
        </p>
      </section>
    )
  }

</SiteLayout>
