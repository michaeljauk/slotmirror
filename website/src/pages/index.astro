    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={preview} />
    <script is:inline>
      // Theme: follows the system setting until the visitor picks one with the icon button.
      // It shares the storage key and the data-theme attribute with Starlight, so the choice
      // carries over to the docs. Inline in <head>, so that the first paint has the right theme.
      (() => {
        const root = document.documentElement;
        const KEY = "starlight-theme";
        const system = matchMedia("(prefers-color-scheme: dark)");
        const icon = (body) =>
          `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${body}</svg>`;
        const SUN = icon(
          '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
        );
        const MOON = icon('<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>');
        let stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch {}
        if (stored !== "dark" && stored !== "light") stored = null;
        function render() {
          const dark = root.dataset.theme === "dark";
          const label = dark ? "Switch to light mode" : "Switch to dark mode";
          for (const button of document.querySelectorAll("[data-theme-toggle]")) {
            // In dark mode the button offers the sun (go light), in light mode the moon.
            button.innerHTML = dark ? SUN : MOON;
            button.setAttribute("aria-label", label);
            button.title = label;
          }
        }
        function apply(theme) {
          root.dataset.theme = theme;
          render();
        }
        root.dataset.theme = stored ?? (system.matches ? "dark" : "light");
        system.addEventListener("change", (event) => {
          if (!stored) apply(event.matches ? "dark" : "light");
        });
        document.addEventListener("DOMContentLoaded", render);
        document.addEventListener("click", (event) => {
          if (!event.target.closest("[data-theme-toggle]")) return;
          stored = root.dataset.theme === "dark" ? "light" : "dark";
          try {
            localStorage.setItem(KEY, stored);
          } catch {}
          apply(stored);
        });
      })();
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href={page("")}>
          <svg viewBox="0 0 64 64" aria-hidden="true">
            <defs>
              <pattern
                id="logo-hatch"
                width="5"
                height="5"
                patternUnits="userSpaceOnUse"
                patternTransform="rotate(45)"><rect width="2.4" height="5" fill="currentColor"
                ></rect></pattern
              >
            </defs>
            <g fill="none" stroke="currentColor" stroke-width="4">
              <rect x="5" y="7" width="23" height="50" rx="6"></rect>
              <rect x="36" y="7" width="23" height="50" rx="6"></rect>
            </g>
            <rect x="10.5" y="22" width="12" height="18" rx="3" fill="var(--accent)"></rect>
            <rect x="41.5" y="22" width="12" height="18" rx="3" fill="url(#logo-hatch)"></rect>
          </svg>
          slotmirror
        </a>
        <nav class="links" aria-label="Main">
          <a href={page("docs/introduction/")}>Docs</a>
          <a href="#guides" class="hide-sm">Guides</a>
          <a href={page("changelog/")} class="hide-sm">Changelog</a>
          <a href={repo}>GitHub</a>
          <button class="theme" data-theme-toggle type="button" aria-label="Switch theme"></button>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap hero">
        <div>
          <h1>Stop getting double-booked across your Microsoft and Google calendars.</h1>
          <p class="sub">{heroSub}</p>
          <div class="buttons">
            <a class="button primary" href={page("docs/quickstart/")} data-track="quickstart_click"
              ><Fragment set:html={cloudflare} />Start the quickstart</a
            >
            <a class="button" href={repo}><Fragment set:html={github} />View on GitHub</a>
          </div>
          <p class="prereq">
            Before you start: you register your own Microsoft Entra app and Google OAuth client.
            This is an early version, below 1.0. Settings and the database can still change
            between releases.
          </p>
          <p class="note">Runs on the Cloudflare Workers free plan · MIT licence</p>
        </div>

        <div class="demo" role="region" aria-label="Interactive demo">
