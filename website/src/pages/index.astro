---
import Demo from "../components/Demo.astro";
import DetailPicker from "../components/DetailPicker.astro";
import Iso from "../components/Iso.astro";
import Logo from "../components/Logo.astro";
import SlotField from "../components/SlotField.astro";
import { icons } from "../iso-scenes";
import SiteLayout from "../layouts/SiteLayout.astro";
import { detail, guides, hero, how, pillars } from "../home-content";
import { cloudflare, github } from "../icons";
import { previewAlt, previewHeight, previewWidth, repo } from "../site";

// The search title is short enough for a result page (about 60 characters). Link previews keep
// the hero headline as their title.
const searchTitle = "slotmirror: busy-time sync for Outlook and Google calendars";
const title = "slotmirror: stop getting double-booked across Microsoft and Google calendars";
const description =
  "Sync Outlook and Google calendars as busy blocks. By default only Busy leaves a calendar. Self-hosted in your own Cloudflare account, on the free plan.";

// Hero sentence, two variants. No latency has been measured yet, so the live variant names no
// number. After the measurement, replace `null` with the measured values and the conditions, for
// example { p50: "<value>", p95: "<value>", conditions: "<what was measured>" }. That one change
// adds the second sentence. Never fill in a figure that was not measured.
const latency: { p50: string; p95: string; conditions: string } | null = null;
const heroSub = latency
  ? `${hero.sub} A moved meeting updates its copies in a median of ${latency.p50} (p95: ${latency.p95}; ${latency.conditions}).`
  : hero.sub;

// Links inside the site. The base comes from astro.config.mjs, the only place that sets it.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const page = (path: string) => `${base}/${path}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pillar = (key: string) => pillars.find((item) => item.key === key)!;
const preview = new URL(page("social-preview.png"), Astro.site);

// The waitlist form shows only if both build variables are set. Without them nothing renders.
const waitlistUrl = (import.meta.env.PUBLIC_WAITLIST_URL as string | undefined)
  ?.trim()
  .replace(/\/$/, "");
const turnstileKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined)?.trim();
// An address without https:// would make a relative endpoint, so it counts as unset.
const waitlist = Boolean(waitlistUrl?.startsWith("https://") && turnstileKey);

// release-please writes CHANGELOG.md at the repository root with the first release.
const changelogs = import.meta.glob<string>("../../../CHANGELOG.md", {
  query: "?raw",
  import: "default",
  eager: true,
});
const changelog = Object.values(changelogs)[0] ?? "";
const latest = /^##\s+\[?(\d+\.\d+\.\d+)\]?(?:\([^)]*\))?\s*\((\d{4}-\d{2}-\d{2})\)/m.exec(
  changelog,
);

// Structured data for search engines. Every value here is also visible on the page or in the
// repository. The version appears only after the first release.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${canonical.href}#website`,
      name: "slotmirror",
      url: canonical.href,
      description,
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${canonical.href}#software`,
      name: "slotmirror",
      description,
      url: canonical.href,
      image: preview.href,
      applicationCategory: "BusinessApplication",
      operatingSystem: "Web",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      sameAs: [repo],
      ...(latest ? { softwareVersion: latest[1] } : {}),
    },
  ],
};
// JSON inside a script tag must not contain "</script>", so every "<" becomes an escape.
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<SiteLayout title={searchTitle} description={description} bodyClass="home">
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="slotmirror" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={preview} />
    <meta property="og:image:width" content={previewWidth} />
    <meta property="og:image:height" content={previewHeight} />
    <meta property="og:image:alt" content={previewAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={preview} />
    <meta name="twitter:image:alt" content={previewAlt} />
    <script type="application/ld+json" is:inline set:html={structuredDataJson} />
  </Fragment>

  <div class="hero on-deep">
    <SlotField id="hero-field" class="slot-field" />
    <div class="hero-inner">
      <div>
        <span class="eyebrow">Open source · Self-hosted</span>
        <h1>{hero.title}</h1>
        <p class="sub">{heroSub}</p>
        <div class="buttons">
          <a class="button primary" href={page("docs/quickstart/")} data-track="quickstart_click"
            ><Fragment set:html={cloudflare} />Start the quickstart</a
          >
          <a class="button outline" href={repo}><Fragment set:html={github} />View on GitHub</a>
        </div>
        <p class="free">{hero.free}</p>
      </div>
      <div class="hero-stage">
        <span class="badge hatched b1" style="--c:var(--work)"
          ><i></i>“Busy” by default</span
        >
        <span class="badge late b2"><i></i>Copies follow a moved meeting</span>
        <div class="hero-card"><Demo /></div>
      </div>
    </div>
  </div>

  <section class="show">
    <div class="card card-vermilion wide on-deep">
      <div class="card-text">
        <h2 class="loud">{detail.title}</h2>
        <p>{detail.lead}</p>
        <p>{pillar("privacy").text}</p>
      </div>
      <div class="mock">
        <div class="window"><DetailPicker /></div>
        <span class="badge late" style="--c:var(--private)"><i></i>{pillar("privacy").title}</span>
      </div>
    </div>

    <div class="card card-blue on-deep">
      <div class="card-text">
        <h2 class="loud">{pillar("moves").title}</h2>
        <p>{pillar("moves").text}</p>
      </div>
      <div class="mock iso-mock" aria-hidden="true">
        <span class="badge b-top" style="--c:var(--work)"><i></i>Moved to Thursday</span>
        <span class="badge hatched late b-bottom" style="--c:var(--work)"
          ><i></i>The copy moves too</span
        >
        <Iso boxes={icons.moves!} id="iso-moves" class="iso" scale={30} />
      </div>
    </div>

    <div class="card card-green on-deep">
      <div class="card-text">
        <h2 class="loud">{pillar("more").title}</h2>
        <p>{pillar("more").text}</p>
      </div>
      <div class="mock iso-mock" aria-hidden="true">
        <span class="badge b-top" style="--c:var(--work)"><i></i>Work</span>
        <span class="badge late b-side" style="--c:var(--client)"><i></i>Client</span>
        <span class="badge b-bottom" style="--c:var(--private)"><i></i>Team fixtures</span>
        <Iso boxes={icons.more!} id="iso-more" class="iso" scale={30} />
      </div>
    </div>
  </section>

  <section>
    <h2 class="loud center rule">{how.title}</h2>
    <p class="lead center">
      {how.lead}{" "}
      <a href={page(how.link.slug)}>{how.link.text}</a>
    </p>
    <ol class="steps">
      {
        how.steps.map((step, index) => (
          <li>
            <span class="num">{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="small center">{how.note}</p>
  </section>

  <section id="guides">
    <h2 class="loud center rule">Start from your situation</h2>
    <ul class="guide-list">
      {
        guides.map((guide) => (
          <li>
            <a href={page(`guides/${guide.slug}/`)}>
              <span class="g-title">{guide.title}</span>
              <span class="g-text">{guide.text}</span>
              <span class="g-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    latest && (
      <section id="changelog">
        <h2 class="loud rule">Changelog</h2>
        <p class="changes">
          <span class="version">{latest[1]}</span>
          <time datetime={latest[2]}>{latest[2]}</time>
          <a href={page("changelog/")}>All releases</a>
        </p>
      </section>
    )
  }

  {
    waitlist && (
      <section id="waitlist">
        <h2 class="loud rule">Not available yet</h2>
        <p class="lead">
          A hosted slotmirror does not exist yet. Leave your address to hear when it opens.
          Joining the list is not a purchase.
        </p>
        <form
          class="waitlist"
          id="waitlist-form"
          method="post"
          hidden
          data-endpoint={`${waitlistUrl}/api/signup`}
          data-site-key={turnstileKey}
        >
          <label for="waitlist-email">Email address</label>
          <div class="waitlist-row">
            <input
              id="waitlist-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              maxlength="254"
              required
              aria-describedby="waitlist-status"
            />
            <button class="button primary" type="submit" id="waitlist-submit">
              Join the waitlist
            </button>
          </div>
          <div id="waitlist-widget" class="waitlist-widget" />
          <p id="waitlist-status" class="waitlist-status" role="status" aria-live="polite" />
          <p class="note">
            We use your address only for this list. We send one mail to confirm it. You can
            unsubscribe from that mail. <a href={page("privacy/")}>Privacy notice</a>
          </p>
        </form>
      </section>
    )
  }

  <section>
    <div class="cta-card on-deep">
      <SlotField id="cta-field" class="slot-field" cols={16} rows={9} />
      <div class="eyes" data-eyes><Logo id="logo-big" /></div>
      <div class="cta-text">
        <h2 class="loud">Your calendars keep an eye on each other.</h2>
        <p>{hero.free}</p>
        <div class="buttons">
          <a class="button primary" href={page("docs/quickstart/")}
            ><Fragment set:html={cloudflare} />Start the quickstart</a
          >
          <a class="button outline" href={repo}><Fragment set:html={github} />View on GitHub</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    // The waitlist code loads only if this build renders the form.
    if (document.querySelector("#waitlist-form")) void import("../scripts/waitlist");
  </script>
</SiteLayout>
