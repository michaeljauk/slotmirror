{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The website: static Astro output plus a small Worker for the PostHog proxy.
  "name": "slotmirror-website",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only the proxy path runs the Worker first. Pages are served as static assets, free of charge.
    "run_worker_first": ["/ingest/*"],
  },
  // The first deploy creates the DNS record for slotmirror.com in the Cloudflare zone of the same name.
  "routes": [{ "pattern": "slotmirror.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
}
