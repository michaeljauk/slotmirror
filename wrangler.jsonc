{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slotmirror",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-25",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slotmirror",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT_SYNC", "class_name": "AccountSync" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountSync"] }],
  "triggers": { "crons": ["*/10 * * * *"] },
  // Access and URL settings (ALLOWED_EMAILS, ADMIN_EMAILS, PUBLIC_URL, DATA_JURISDICTION, ...) are
  // not listed under "vars" on purpose. A "vars" entry here, even an empty one, replaces the value
  // that you set in the Cloudflare dashboard on every deploy. Set them in the dashboard (Workers &
  // Pages > your Worker > Settings > Variables and Secrets) or in .dev.vars for local development.
  // "keep_vars" keeps dashboard values that this file does not name.
  "keep_vars": true,
}
